
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delicious Restaurant Menu</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #fff3e0, #ffe0b2);
            font-family: Arial, sans-serif;
        }

        .navbar {
            background: linear-gradient(to right, #8e0000, #ff5722);
        }

        .navbar-brand {
            color: white !important;
            font-size: 28px;
            font-weight: bold;
        }

        .header {
            background: linear-gradient(to right, #ff5722, #ff9800);
            color: white;
            text-align: center;
            padding: 55px 20px;
            border-bottom: 5px solid #8e0000;
        }

        .header h1 {
            font-size: 42px;
            font-weight: bold;
            text-shadow: 3px 3px 5px #555;
        }

        .category-title {
            color: #a52a2a;
            font-weight: bold;
            border-left: 6px solid #ff5722;
            padding-left: 12px;
            margin: 35px 0 20px;
        }

        .food-card {
            border: 2px solid #ff9800;
            border-radius: 15px;
            overflow: hidden;
            transition: 0.3s;
            height: 100%;
        }

        .food-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 8px 20px #999;
        }

        .food-card img {
            height: 200px;
            width: 100%;
            object-fit: cover;
        }

        .food-card .card-title {
            color: #8e0000;
            font-weight: bold;
        }

        .price {
            color: #e65100;
            font-size: 22px;
            font-weight: bold;
        }

        .footer {
            background: linear-gradient(to right, #8e0000, #ff5722);
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 40px;
        }
    </style>
</head>

<body>

<!-- Navigation Bar -->
<nav class="navbar navbar-expand-lg">
    <div class="container">
        <a class="navbar-brand" href="#">Food Paradise</a>
        <button class="navbar-toggler bg-light" type="button"
                data-bs-toggle="collapse" data-bs-target="#menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menu">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link text-white" href="#">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" href="#menu-items">Menu</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" href="#contact">Contact</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- Header -->
<header class="header">
    <h1>Welcome to Food Paradise</h1>
    <p>Delicious Food | Fresh Ingredients | Great Taste</p>
</header>

<div class="container" id="menu-items">

    <!-- Pizza Category -->
    <h2 class="category-title">🍕 Pizza</h2>
    <div class="row g-4">

        <div class="col-md-4">
            <div class="card food-card">
                <img src="https://images.unsplash.com/photo-1513104890138-7c749659a591?w=600"
                     class="card-img-top" alt="Cheese Pizza">
                <div class="card-body">
                    <h5 class="card-title">Cheese Pizza</h5>
                    <p>Delicious pizza topped with fresh cheese and herbs.</p>
                    <p class="price">₹199</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card food-card">
                <img src="https://images.unsplash.com/photo-1579751626657-72bc17010498?w=600"
                     class="card-img-top" alt="Veg Pizza">
                <div class="card-body">
                    <h5 class="card-title">Veg Pizza</h5>
                    <p>Loaded with fresh vegetables and mozzarella cheese.</p>
                    <p class="price">₹249</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card food-card">
                <img src="https://images.unsplash.com/photo-1571407970349-bc81e7e96d47?w=600"
                     class="card-img-top" alt="Farmhouse Pizza">
                <div class="card-body">
                    <h5 class="card-title">Farmhouse Pizza</h5>
                    <p>A tasty combination of vegetables, cheese and spices.</p>
                    <p class="price">₹299</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Burger Category -->
    <h2 class="category-title">🍔 Burgers</h2>
    <div class="row g-4">

        <div class="col-md-4">
            <div class="card food-card">
                <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=600"
                     alt="Veg Burger">
                <div class="card-body">
                    <h5 class="card-title">Veg Burger</h5>
                    <p>Crispy vegetable patty with fresh lettuce and sauce.</p>
                    <p class="price">₹99</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card food-card">
                <img src="https://images.unsplash.com/photo-1553979459-d2229ba7433a?w=600"
                     alt="Cheese Burger">
                <div class="card-body">
                    <h5 class="card-title">Cheese Burger</h5>
                    <p>Juicy burger with cheese, vegetables and special sauce.</p>
                    <p class="price">₹149</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card food-card">
                <img src="https://images.unsplash.com/photo-1550547660-d9450f859349?w=600"
                     alt="Double Burger">
                <div class="card-body">
                    <h5 class="card-title">Double Burger</h5>
                    <p>Double patty burger with delicious toppings.</p>
                    <p class="price">₹199</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Dessert Category -->
    <h2 class="category-title">🍰 Desserts</h2>
    <div class="row g-4">

        <div class="col-md-4">
            <div class="card food-card">
                <img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=600"
                     alt="Chocolate Cake">
                <div class="card-body">
                    <h5 class="card-title">Chocolate Cake</h5>
                    <p>Rich chocolate cake with creamy chocolate frosting.</p>
                    <p class="price">₹120</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card food-card">
                <img src="https://images.unsplash.com/photo-1563805042-7684c019e1cb?w=600"
                     alt="Ice Cream">
                <div class="card-body">
                    <h5 class="card-title">Ice Cream</h5>
                    <p>Fresh and creamy ice cream with delicious toppings.</p>
                    <p class="price">₹80</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card food-card">
                <img src="https://images.unsplash.com/photo-1488477181946-6428a0291777?w=600"
                     alt="Fruit Dessert">
                <div class="card-body">
                    <h5 class="card-title">Fruit Dessert</h5>
                    <p>Fresh seasonal fruits served with sweet cream.</p>
                    <p class="price">₹100</p>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Footer -->
<footer class="footer" id="contact">
    <h4>Food Paradise Restaurant</h4>
    <p>Address: Vadodara, Gujarat, India</p>
    <p>Contact: +91 98765 43210</p>
    <p>© 2026 Food Paradise. All Rights Reserved.</p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>
