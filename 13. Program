
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ABC College</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: #f4f7fb;
        }

        .navbar {
            background-color: #073763;
        }

        .navbar-brand, .nav-link {
            color: white !important;
            font-weight: bold;
        }

        .hero {
            background: linear-gradient(
                rgba(0,0,0,0.6),
                rgba(0,0,0,0.6)
            ), url("https://images.unsplash.com/photo-1562774053-701939374585?w=1400");
            background-size: cover;
            background-position: center;
            color: white;
            text-align: center;
            padding: 100px 20px;
        }

        .hero h1 {
            font-size: 42px;
            font-weight: bold;
            text-shadow: 2px 2px 5px black;
        }

        .section-title {
            color: #073763;
            font-weight: bold;
            text-align: center;
            margin-bottom: 30px;
        }

        .college-img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-radius: 10px;
        }

        .course-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 3px 12px #cccccc;
            padding: 15px;
            height: 100%;
        }

        .course-card h5 {
            color: #073763;
            font-weight: bold;
        }

        .footer {
            background-color: #073763;
            color: white;
            padding: 25px;
            text-align: center;
        }

        @media (max-width: 576px) {
            .hero h1 {
                font-size: 28px;
            }

            .hero {
                padding: 65px 15px;
            }
        }
    </style>
</head>

<body>

<!-- Navigation Bar -->
<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
        <a class="navbar-brand" href="#">ABC COLLEGE</a>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menu">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="#home">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#about">About</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#courses">Courses</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#facilities">Facilities</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#contact">Contact</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- Header Section -->
<header class="hero" id="home">
    <div class="container">
        <h1>Welcome to ABC College</h1>
        <p class="lead">Building Knowledge, Skills and Bright Futures</p>
        <a href="#courses" class="btn btn-warning btn-lg mt-3">
            Explore Courses
        </a>
    </div>
</header>

<!-- About Section -->
<section class="container py-5" id="about">
    <h2 class="section-title">About Our College</h2>

    <div class="row align-items-center">
        <div class="col-md-6 mb-3">
            <img class="college-img"
                 src="https://images.unsplash.com/photo-1562774053-701939374585?w=800"
                 alt="College Building">
        </div>

        <div class="col-md-6">
            <h3>Welcome to ABC College</h3>
            <p>
                ABC College is committed to providing quality education
                and developing talented students. Our institution provides
                a friendly learning environment with experienced faculty
                and modern facilities.
            </p>
            <p>
                We focus on academic excellence, practical knowledge,
                innovation and overall student development.
            </p>
        </div>
    </div>
</section>

