
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SmartTech Product Store</title>

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

<style>

/* General Styling */
body {
    font-family: Arial, sans-serif;
    background: #f4f7fa;
    margin: 0;
}

/* Navigation Styling */
.navbar {
    background: linear-gradient(to right, #141e30, #243b55);
}

.navbar-brand {
    color: white !important;
    font-size: 26px;
    font-weight: bold;
}

.nav-link {
    color: white !important;
    margin-left: 15px;
    transition: 0.4s;
}

/* Pseudo-class */
.nav-link:hover {
    color: #ffc107 !important;
    transform: scale(1.1);
}

/* Hero Section */
.hero {
    background: linear-gradient(120deg, #141e30, #4b79a1);
    color: white;
    padding: 80px 20px;
    text-align: center;
}

.hero h1 {
    font-size: 45px;
    font-weight: bold;
    animation: slideDown 1.5s ease;
}

/* Animation */
@keyframes slideDown {
    from {
        opacity: 0;
        transform: translateY(-50px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Pseudo-element */
.hero p::after {
    content: " ★★★★★";
    color: yellow;
    font-size: 20px;
}

/* Product Section */
.product-section {
    padding: 50px 20px;
}

.product-card {
    border: 2px solid #ddd;
    border-radius: 15px;
    overflow: hidden;
    transition: all 0.4s ease;
    background: white;
}

/* Hover pseudo-class */
.product-card:hover {
    transform: translateY(-12px);
    box-shadow: 0 10px 25px #999;
    border-color: #007bff;
}

/* Image Manipulation */
.product-card img {
    width: 100%;
    height: 250px;
    object-fit: contain;
    padding: 15px;
    transition: transform 0.5s;
}

/* Image hover effect */
.product-card:hover img {
    transform: scale(1.12) rotate(2deg);
}

/* Pseudo-element */
.product-title::before {
    content: "★ ";
    color: orange;
}

/* Product Price */
.price {
    color: #e63946;
    font-size: 25px;
    font-weight: bold;
}

/* Button Styling */
.btn-buy {
    background: #007bff;
    color: white;
    border-radius: 25px;
    padding: 10px 25px;
    transition: 0.4s;
}

/* Button pseudo-class */
.btn-buy:hover {
    background: #ff5722;
    color: white;
    transform: scale(1.08);
}

/* About Section */
.about {
    background: #e3f2fd;
    padding: 45px 20px;
    text-align: center;
}

.about h2::after {
    content: "";
    display: block;
    width: 80px;
    height: 4px;
    background: #007bff;
    margin: 10px auto;
}

/* Footer */
footer {
    background: #141e30;
    color: white;
    text-align: center;
    padding: 20px;
}

/* Selection pseudo-element */
::selection {
    background: #007bff;
    color: white;
}

</style>
</head>

<body>

