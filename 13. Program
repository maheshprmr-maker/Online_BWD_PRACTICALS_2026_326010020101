        </div>

        <div class="col-md-4 col-sm-6">
            <div class="p-4 bg-white rounded shadow-sm">
                <h4>🏟️ Sports</h4>
                <p>Sports facilities for physical fitness and activities.</p>
            </div>
        </div>

    </div>
</section>

