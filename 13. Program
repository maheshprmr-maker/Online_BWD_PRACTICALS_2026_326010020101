<section class="container py-5" id="courses">
    <h2 class="section-title">Our Courses</h2>

    <div class="row g-4">

        <div class="col-md-4 col-sm-6">
            <div class="course-card">
                <img class="college-img"
                     src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=700"
                     alt="Computer Science">
                <h5 class="mt-3">BCA</h5>
                <p>Bachelor of Computer Applications.</p>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="course-card">
                <img class="college-img"
                     src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?w=700"
                     alt="Business Studies">
                <h5 class="mt-3">BBA</h5>
                <p>Bachelor of Business Administration.</p>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="course-card">
                <img class="college-img"
                     src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?w=700"
                     alt="Commerce">
                <h5 class="mt-3">B.Com</h5>
                <p>Bachelor of Commerce.</p>
            </div>
        </div>

    </div>
</section>

<!-- Facilities Section -->
<section class="container py-5" id="facilities">
    <h2 class="section-title">Our Facilities</h2>

    <div class="row text-center g-4">

        <div class="col-md-4 col-sm-6">
            <div class="p-4 bg-white rounded shadow-sm">
                <h4>📚 Library</h4>
                <p>Well-equipped library with thousands of books.</p>
